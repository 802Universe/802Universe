{
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "802universe",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-23",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Replace id with the one printed by:  npx wrangler kv namespace create CONTENT
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }
  ],

  // Both values come from the Cloudflare Access application you create.
  // Neither is a secret — the AUD tag is only meaningful together with
  // Cloudflare's signature, so it is safe in the repo.
  "vars": {
    "TEAM_DOMAIN": "https://YOUR-TEAM-NAME.cloudflareaccess.com",
    "POLICY_AUD": "PASTE_YOUR_APPLICATION_AUDIENCE_TAG_HERE"
  },

  "observability": { "enabled": true }
}
