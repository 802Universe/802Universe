{
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "802universe",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-23",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download/*", "/api/*", "/admin/api/*"]
  },

  // Replace id with the one printed by:  npx wrangler kv namespace create CONTENT
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "33f168c27fb547f1a3778c672e5ba8a1" }
  ],

  // Both values come from the Cloudflare Access application you create.
  // Neither is a secret — the AUD tag is only meaningful together with
  // Cloudflare's signature, so it is safe in the repo.
"vars": {
  "TEAM_DOMAIN": "https://odd-mode-557c.cloudflareaccess.com",
  "POLICY_AUD": "73fe336b62eb29345de1ba18d82856f74768d9059a5e0bd3fd7a51b53ca9ef6f"
},

  "observability": { "enabled": true }
}
